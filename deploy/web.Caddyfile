# Configuração da imagem do alvo `web` (deploy/Dockerfile): o Caddy só serve os arquivos do
# app, em HTTP na porta 80. O TLS e a rota /v1 para a API são do proxy da plataforma, na mesma
# origem (ADR 0008 e ADR 0009).
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	# A mesma política do index.html, agora como cabeçalho.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# O Caddy fala HTTP, mas só o proxy da plataforma chega até ele, e o proxy só atende HTTPS.
		Strict-Transport-Security "max-age=31536000"
	}

	# /v1 é da API. Se uma chamada chegar aqui, a rota do proxy está errada: responder com o
	# index.html esconderia o problema atrás de um erro de JSON no app.
	handle /v1/* {
		respond "A rota /v1 deve ser encaminhada para a API pelo proxy." 404
	}

	handle {
		root * /srv
		# Arquivos com hash no nome nunca mudam; o index.html é sempre conferido.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		header / Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
