# Lords of the Guild: variáveis de ambiente (MVP-ROADMAP.md §1.3).
# Copie para deploy/.env (nunca commitado) ou rode `pnpm secrets:gen`, que cria o arquivo
# e preenche só os segredos que estiverem vazios.

# --- API ---------------------------------------------------------------------

# Porta HTTP da API.
PORT=3000

# Conexão principal com o PostgreSQL. No dev aponta para o serviço `db` do compose.
DATABASE_URL=postgres://lotg:lotg@localhost:5432/lotg

# Banco dos testes de integração (serviço `db_test`). Sem ela, `pnpm test:integration` passa vazio.
TEST_DATABASE_URL=postgres://lotg:lotg@localhost:5433/lotg_test

# Chave dos JWTs: 32+ bytes aleatórios em base64. Pode ser trocada; só derruba as sessões ativas.
JWT_SECRET=

# Chave HMAC dos Códigos do Reino: 32+ bytes aleatórios em base64, INDEPENDENTE de JWT_SECRET.
# Trocá-la invalida todos os códigos já emitidos. Preserve-a em deploys e restaurações,
# junto aos segredos operacionais; nunca a regenere a cada deploy.
RECOVERY_CODE_SECRET=

# URL pública da API, usada como emissor dos JWTs, em logs e em /v1/version.
PUBLIC_URL=http://localhost:3000

# Nível de log do pino. Produção: info.
LOG_LEVEL=debug

# Limites de taxa.
RATE_LIMIT_PER_MINUTE=60
ACCOUNT_CREATE_PER_HOUR_PER_IP=10
RECOVERY_ATTEMPTS_PER_HOUR_PER_IP=5

# Job de avanço: intervalo entre execuções. Produção: 3600000 (1 h).
ADVANCE_JOB_INTERVAL_MS=60000

# Uma partida é considerada parada depois de tanto tempo sem estado persistido.
ADVANCE_STALE_AFTER_MS=3600000

# API do GitHub usada para validar o vínculo de conta. Os testes a sobrescrevem.
GITHUB_API_URL=https://api.github.com

# Vínculo com o GitHub pelo navegador (device flow). GITHUB_CLIENT_ID é o identificador público
# de um OAuth App com "Device Flow" habilitado; não é segredo. Vazio = vínculo desligado: as
# rotas /v1/auth/github/device respondem 404 e o app esconde o botão.
GITHUB_CLIENT_ID=
GITHUB_OAUTH_URL=https://github.com

# Confiar no X-Forwarded-For. Ligue só atrás do proxy reverso (Caddy, em produção): sem isso,
# todos os jogadores parecem vir do IP do proxy e dividem os limites por IP.
TRUST_PROXY=false

# --- Produção (Coolify) -------------------------------------------------------

# Em produção não existe deploy/.env: as variáveis ficam no Coolify, na aplicação `lotg-api`
# (ADR 0009 e deploy/README.md). Valores que mudam em relação ao desenvolvimento:
#
#   DATABASE_URL          URL interna do banco `lotg-db` (o Coolify a mostra na página do banco)
#   JWT_SECRET            openssl rand -base64 48
#   RECOVERY_CODE_SECRET  openssl rand -base64 48, outra execução; guardar uma cópia fora do Coolify
#   PUBLIC_URL            https://<domínio>, sem /v1
#   LOG_LEVEL             info
#   TRUST_PROXY           true
#   ADVANCE_JOB_INTERVAL_MS  3600000
#   GITHUB_CLIENT_ID      o do OAuth App, ou vazio para deixar o vínculo desligado
#
# A senha do banco é definida na criação do `lotg-db` e só aparece dentro da DATABASE_URL.
