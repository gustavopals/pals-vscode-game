{
  "name": "@lotg/server",
  "version": "0.1.0",
  "private": true,
  "description": "Lords of the Guild: Servidor autoritativo",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../deploy/.env src/main.ts",
    "db:migrate": "tsx --env-file-if-exists=../../deploy/.env src/db/migrate-cli.ts",
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. --project unit",
    "db:generate": "drizzle-kit generate",
    "start": "node dist/main.js"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.6",
    "@lotg/content": "workspace:*",
    "@lotg/engine": "workspace:*",
    "@lotg/protocol": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  }
}
