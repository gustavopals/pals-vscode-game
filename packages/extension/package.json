{
  "name": "lords-of-the-guild",
  "displayName": "Lords of the Guild",
  "description": "Um feudo medieval que você governa nas pausas do café, dentro do VS Code.",
  "version": "0.1.0",
  "private": true,
  "publisher": "gustavopals",
  "repository": {
    "type": "git",
    "url": "https://github.com/gustavopals/pals-vscode-game.git",
    "directory": "packages/extension"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "jogo",
    "game",
    "estratégia",
    "medieval",
    "idle"
  ],
  "icon": "icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lords",
          "title": "Lords of the Guild",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "lords": [
        {
          "id": "lords.tree",
          "name": "Pedra Alta",
          "icon": "media/activity-bar.svg",
          "contextualTitle": "Lords of the Guild"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "lords.tree",
        "contents": "Um feudo espera por você.\n[Jogar agora](command:lords.openPanel)\nJá governa um feudo em outra máquina?\n[Entrar com GitHub](command:lords.signInGithub)\n[Usar Código do Reino](command:lords.signInRecoveryCode)",
        "when": "!lords.signedIn"
      }
    ],
    "commands": [
      {
        "command": "lords.openPanel",
        "title": "Abrir painel",
        "category": "Lords",
        "icon": "$(home)"
      },
      {
        "command": "lords.allocateWorkers",
        "title": "Alocar trabalhadores…",
        "category": "Lords"
      },
      {
        "command": "lords.build",
        "title": "Construir ou melhorar…",
        "category": "Lords",
        "icon": "$(arrow-circle-up)"
      },
      {
        "command": "lords.cancelConstruction",
        "title": "Cancelar a obra em andamento",
        "category": "Lords"
      },
      {
        "command": "lords.planConstruction",
        "title": "Planejar ou desplanejar uma obra…",
        "category": "Lords"
      },
      {
        "command": "lords.recruit",
        "title": "Recrutar aldeões…",
        "category": "Lords"
      },
      {
        "command": "lords.renameSettlement",
        "title": "Renomear o feudo…",
        "category": "Lords"
      },
      {
        "command": "lords.newGame",
        "title": "Nova partida…",
        "category": "Lords"
      },
      {
        "command": "lords.exportChronicle",
        "title": "Exportar Crônica (Markdown)",
        "category": "Lords"
      },
      {
        "command": "lords.about",
        "title": "Sobre",
        "category": "Lords"
      },
      {
        "command": "lords.toggleDiscreetMode",
        "title": "Modo discreto",
        "category": "Lords"
      },
      {
        "command": "lords.muteNotifications",
        "title": "Silenciar notificações por 2 horas",
        "category": "Lords"
      },
      {
        "command": "lords.refresh",
        "title": "Atualizar agora",
        "category": "Lords",
        "icon": "$(refresh)"
      },
      {
        "command": "lords.linkGithub",
        "title": "Vincular conta ao GitHub",
        "category": "Lords"
      },
      {
        "command": "lords.signInGithub",
        "title": "Entrar com GitHub",
        "category": "Lords"
      },
      {
        "command": "lords.generateRecoveryCode",
        "title": "Gerar Código do Reino",
        "category": "Lords"
      },
      {
        "command": "lords.signInRecoveryCode",
        "title": "Entrar com Código do Reino",
        "category": "Lords"
      },
      {
        "command": "lords.signOut",
        "title": "Sair desta máquina",
        "category": "Lords"
      },
      {
        "command": "lords.deleteAccount",
        "title": "Excluir conta…",
        "category": "Lords"
      },
      {
        "command": "lords.openSettings",
        "title": "Abrir configurações",
        "category": "Lords",
        "icon": "$(gear)"
      },
      {
        "command": "lords.workersIncrease",
        "title": "Mais um trabalhador",
        "category": "Lords",
        "icon": "$(add)"
      },
      {
        "command": "lords.workersDecrease",
        "title": "Menos um trabalhador",
        "category": "Lords",
        "icon": "$(remove)"
      },
      {
        "command": "lords.privacy",
        "title": "Privacidade",
        "category": "Lords"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "lords.openPanel",
          "when": "view == lords.tree",
          "group": "navigation@1"
        },
        {
          "command": "lords.refresh",
          "when": "view == lords.tree && lords.signedIn",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "lords.workersDecrease",
          "when": "view == lords.tree && viewItem == lords.worker",
          "group": "inline@1"
        },
        {
          "command": "lords.workersIncrease",
          "when": "view == lords.tree && viewItem == lords.worker",
          "group": "inline@2"
        },
        {
          "command": "lords.cancelConstruction",
          "when": "view == lords.tree && viewItem == lords.activeConstruction"
        },
        {
          "command": "lords.build",
          "when": "view == lords.tree && viewItem == lords.upgrade",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "lords.workersIncrease",
          "when": "false"
        },
        {
          "command": "lords.workersDecrease",
          "when": "false"
        },
        {
          "command": "lords.linkGithub",
          "when": "lords.signedIn"
        },
        {
          "command": "lords.generateRecoveryCode",
          "when": "lords.signedIn"
        },
        {
          "command": "lords.signOut",
          "when": "lords.signedIn"
        },
        {
          "command": "lords.deleteAccount",
          "when": "lords.signedIn"
        },
        {
          "command": "lords.signInGithub",
          "when": "!lords.signedIn"
        },
        {
          "command": "lords.signInRecoveryCode",
          "when": "!lords.signedIn"
        }
      ]
    },
    "configuration": {
      "title": "Lords of the Guild",
      "properties": {
        "lords.serverUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "markdownDescription": "Endereço do servidor do jogo. O padrão aponta para um servidor local de desenvolvimento (`pnpm dev:api`); passará a ser a instância hospedada quando ela existir. Só pode ser definido nas configurações do usuário: um repositório aberto não consegue apontar a extensão para outro servidor.",
          "scope": "application"
        },
        "lords.notifications": {
          "type": "string",
          "enum": [
            "silent",
            "essential",
            "all"
          ],
          "enumDescriptions": [
            "Silenciosa: nenhuma notificação.",
            "Essenciais: só o que pede atenção, como a fome.",
            "Todas: inclui obras concluídas, aldeões que chegam e objetivos."
          ],
          "default": "essential",
          "description": "Quais acontecimentos do feudo viram notificação. No máximo 3 por hora."
        },
        "lords.discreetMode": {
          "type": "boolean",
          "default": false,
          "description": "Modo discreto: a barra de status mostra só um contador e nenhuma notificação aparece."
        },
        "lords.vigilHour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23,
          "default": 20,
          "description": "Hora da Vigília, no seu horário local: quando os acontecimentos que merecem presença vão ocorrer."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "dev": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. --project unit",
    "package": "pnpm --filter @lotg/webview build && node esbuild.mjs && vsce package --no-dependencies"
  },
  "dependencies": {
    "@lotg/client-sdk": "workspace:*",
    "@lotg/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2"
  }
}
